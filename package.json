{
  "name": "thalamus-card-drive",
  "version": "0.1.0",
  "description": "Highly advanced physics card drive and drift game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "prepare": "husky install"
  },
  "keywords": [
    "physics",
    "game",
    "threejs",
    "cannon-es",
    "drift",
    "card-game"
  ],
  "author": "Thalamus AI",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0",
    "cannon-es": "^0.20.0",
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.3.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}